{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@pegma/authorization-auth0": ["./packages/auth0/src/index.ts"],
      "@pegma/authorization-contracts": ["./packages/contracts/src/index.ts"],
      "@pegma/authorization-core": ["./packages/core/src/index.ts"],
      "@pegma/authorization-core/conformance": [
        "./packages/core/src/conformance.ts"
      ],
      "@pegma/authorization-entra": ["./packages/entra/src/index.ts"],
      "@pegma/authorization-identity": [
        "./packages/identity-link/src/index.ts"
      ],
      "@pegma/authorization-policy": ["./packages/policy/src/index.ts"],
      "@pegma/authorization-storage": ["./packages/storage/src/index.ts"],
      "@pegma/authorization-stripe": ["./packages/stripe/src/index.ts"],
      "@pegma/authorization-tokens": ["./packages/tokens/src/index.ts"],
      "@pegma/authorization-tokens/testing": [
        "./packages/tokens/src/testing.ts"
      ]
    }
  },
  "include": [
    "examples/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["packages/**/dist/**", "packages/**/node_modules/**"]
}
