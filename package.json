{
  "name": "authorization-core",
  "version": "0.3.0",
  "private": true,
  "description": "Provider-neutral roles, entitlements, and permissions for SaaS applications.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.check.json --pretty false && npm run docs:api:check",
    "clean": "tsc -b --clean",
    "docs:api": "npm run build && node scripts/api-docs.mjs",
    "docs:api:check": "npm run build && node scripts/api-docs.mjs --check",
    "example": "npm run build && node examples/reference-api/dist/reference-integration.js",
    "example:serve": "npm run build && node examples/reference-api/dist/reference-integration.js --serve",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "node scripts/release-packages.mjs check",
    "release:pack": "node scripts/release-packages.mjs pack",
    "release:publish": "node scripts/release-packages.mjs publish",
    "release:registry:check": "node scripts/release-packages.mjs registry-check",
    "identity-bootstrap:check": "node scripts/release-packages.mjs identity-bootstrap-check",
    "identity-bootstrap:pack": "node scripts/release-packages.mjs identity-bootstrap-pack",
    "identity-bootstrap:registry:check": "node scripts/release-packages.mjs identity-bootstrap-registry-check",
    "entra-bootstrap:check": "node scripts/release-packages.mjs entra-bootstrap-check",
    "entra-bootstrap:pack": "node scripts/release-packages.mjs entra-bootstrap-pack",
    "entra-bootstrap:registry:check": "node scripts/release-packages.mjs entra-bootstrap-registry-check",
    "test": "npm run build && vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
