{
  "name": "authorization-core",
  "version": "0.4.0",
  "private": true,
  "description": "Provider-neutral roles, entitlements, and permissions for SaaS applications.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.check.json --pretty false && pnpm run docs:api:check",
    "clean": "tsc -b --clean",
    "docs:api": "pnpm run build && node scripts/api-docs.mjs",
    "docs:api:check": "pnpm run build && node scripts/api-docs.mjs --check",
    "example": "pnpm run build && node examples/reference-api/dist/reference-integration.js",
    "example:serve": "pnpm run build && node examples/reference-api/dist/reference-integration.js --serve",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "node scripts/release-packages.mjs check",
    "release:pack": "node scripts/release-packages.mjs pack",
    "release:publish": "node scripts/release-packages.mjs publish",
    "release:registry:check": "node scripts/release-packages.mjs registry-check",
    "identity-bootstrap:check": "node scripts/release-packages.mjs identity-bootstrap-check",
    "identity-bootstrap:pack": "node scripts/release-packages.mjs identity-bootstrap-pack",
    "identity-bootstrap:registry:check": "node scripts/release-packages.mjs identity-bootstrap-registry-check",
    "entra-bootstrap:check": "node scripts/release-packages.mjs entra-bootstrap-check",
    "admin-bootstrap:check": "node scripts/release-packages.mjs admin-bootstrap-check",
    "admin-bootstrap:pack": "node scripts/release-packages.mjs admin-bootstrap-pack",
    "admin-bootstrap:registry:check": "node scripts/release-packages.mjs admin-bootstrap-registry-check",
    "entra-bootstrap:pack": "node scripts/release-packages.mjs entra-bootstrap-pack",
    "entra-bootstrap:registry:check": "node scripts/release-packages.mjs entra-bootstrap-registry-check",
    "test": "pnpm run build && vitest run"
  },
  "devDependencies": {
    "@pegma/authorization-admin": "0.4.0",
    "@pegma/authorization-auth0": "0.4.0",
    "@pegma/authorization-contracts": "0.4.0",
    "@pegma/authorization-core": "0.4.0",
    "@pegma/authorization-entra": "0.4.0",
    "@pegma/authorization-identity": "0.4.0",
    "@pegma/authorization-policy": "0.4.0",
    "@pegma/authorization-storage": "0.4.0",
    "@pegma/authorization-stripe": "0.4.0",
    "@pegma/authorization-tokens": "0.4.0",
    "@pegma/storage-core": "0.4.0",
    "@types/node": "^26.1.1",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
