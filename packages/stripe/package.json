{
  "name": "@pegma/authorization-stripe",
  "version": "0.1.1",
  "description": "Trusted Stripe price and feature translation for Authorization Core.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pegma-dev/authorization-core.git",
    "directory": "packages/stripe"
  },
  "dependencies": {
    "@pegma/authorization-contracts": "0.1.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  }
}
