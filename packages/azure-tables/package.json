{
  "name": "@pegma/authorization-azure-tables",
  "version": "0.0.0",
  "description": "Azure Table Storage adapter for Authorization Core persistence ports.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pegma-dev/authorization-core.git",
    "directory": "packages/azure-tables"
  },
  "dependencies": {
    "@azure/data-tables": "13.3.2",
    "@pegma/authorization-contracts": "0.0.0",
    "@pegma/authorization-storage": "0.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  }
}
