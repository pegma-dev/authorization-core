{
  "name": "@pegma/authorization-admin",
  "version": "0.4.0",
  "description": "HTTP-neutral audited role-administration service for Authorization Core hosts.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pegma-dev/authorization-core.git",
    "directory": "packages/admin"
  },
  "dependencies": {
    "@pegma/authorization-contracts": "0.4.0",
    "@pegma/authorization-storage": "0.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit"
  }
}
