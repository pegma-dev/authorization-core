{
  "name": "@pegma/authorization-tokens",
  "version": "0.1.4",
  "description": "Short-lived, one-use signed access grants for Authorization Core.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pegma-dev/authorization-core.git",
    "directory": "packages/tokens"
  },
  "dependencies": {
    "@pegma/authorization-contracts": "0.1.4",
    "@pegma/storage-core": "0.3.0",
    "jose": "6.2.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  }
}
