{
  "name": "@pegma/authorization-policy",
  "version": "0.2.0",
  "description": "Policy parsing, validation, and diagnostics for Authorization Core.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pegma-dev/authorization-core.git",
    "directory": "packages/policy"
  },
  "dependencies": {
    "@pegma/authorization-contracts": "0.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  }
}
